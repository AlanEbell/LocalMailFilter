{
  "manifest_version": 3,
  "name": "Mail Triage",
  "version": "0.1.6",
  "description": "Local-LLM triage of business spam and phishing into a Look At Later folder, with a learning allow-list and a daily report.",
  "author": "Alan Bell",
  "browser_specific_settings": {
    "gecko": {
      "id": "mailtriage@alanbell.local",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "accountsRead",
    "accountsFolders",
    "messagesRead",
    "messagesMove",
    "messagesUpdate",
    "messagesTags",
    "messagesTagsList",
    "compose",
    "compose.send",
    "notifications",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost:11434/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "options_ui": {
    "page": "ui/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Mail Triage",
    "default_icon": "icons/icon-32.png"
  }
}
